# Скопируйте в .env и при необходимости поменяйте значения:
#   cp .env.example .env

# Секрет для подписи JWT-токенов (обязательно сменить вне демо)
JWT_SECRET=change-me-jwt-secret

# Внутренний ключ для межсервисных вызовов (scheduler -> records и т.п.)
INTERNAL_KEY=change-me-internal-key

# Порт, на котором стек доступен снаружи
APP_PORT=8080
